DATABASE_URL="postgresql://postgres:postgres@localhost:5432/velocity_keys?schema=public"
JWT_SECRET="replace-me-with-a-long-random-secret"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
PORT=3000

